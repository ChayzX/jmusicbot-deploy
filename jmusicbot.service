[Unit]
Description=JMusicBot Docker Compose Stack

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/chase/docker/jmusicbot
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
