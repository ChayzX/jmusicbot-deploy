+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.jagrosh.jmusicbot;
+
+import com.sun.net.httpserver.HttpExchange;
+import com.sun.net.httpserver.HttpServer;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.IOException;
+import java.io.OutputStream;
+import java.net.InetSocketAddress;
+import java.nio.charset.StandardCharsets;
+import java.util.concurrent.Executors;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * Minimal HTTP health endpoint for the container so the kubelet probes and
+ * the in-cluster watcher has something to check.
+ *
+ * <p>Deliberately dependency-free: it uses the JDK's built-in
+ * {@code com.sun.net.httpserver.HttpServer} rather than pulling in an HTTP
+ * framework. The image's jlink runtime must therefore include the
+ * {@code jdk.httpserver} module (see the Dockerfile).
+ *
+ * <p>Routes:
+ * <ul>
+ *   <li>{@code GET /health} (and alias {@code /healthz}) — {@code 200
+ *       {"status":"ok"}} once the bot has logged into Discord, otherwise
+ *       {@code 503 {"status":"starting"}}. Used by the readiness probe and by
+ *       Uptime Kuma.</li>
+ *   <li>{@code GET /live} — {@code 200 {"status":"alive"}} whenever this server
+ *       is bound, i.e. whenever the JVM is alive. Used by the liveness probe so
+ *       the kubelet never restarts the pod just because Discord is unreachable
+ *       or the login is slow.</li>
+ * </ul>
+ */
+public class HealthServer {
+
+    private static final Logger LOG = LoggerFactory.getLogger(HealthServer.class);
+
+    /** Port the health endpoint listens on. Keep in sync with the Deployment and Service. */
+    public static final int DEFAULT_PORT = 9091;
+
+    private final int port;
+    private final AtomicBoolean ready = new AtomicBoolean(false);
+    private HttpServer server;
+
+    public HealthServer() {
+        this(DEFAULT_PORT);
+    }
+
+    public HealthServer(int port) {
+        this.port = port;
+    }
+
+    /**
+     * Binds the listener. Safe to call once at startup; failure to bind is
+     * logged, not fatal — the bot can still run, it just can't be health-checked.
+     */
+    public void start() {
+        try {
+            server = HttpServer.create(new InetSocketAddress(port), 0);
+            server.createContext("/health", this::handleHealth);
+            server.createContext("/healthz", this::handleHealth);
+            server.createContext("/live", this::handleLive);
+            server.setExecutor(Executors.newCachedThreadPool());
+            server.start();
+            LOG.info("Health HTTP server listening on port {}", port);
+        }
+        catch (IOException e) {
+            LOG.error("Could not start health HTTP server on port {}", port, e);
+        }
+    }
+
+    /**
+     * Flips the ready state. Called from {@code StartupLifecycleListener.onReady}
+     * once the Discord session is actually ready.
+     */
+    public void setReady(boolean ready) {
+        this.ready.set(ready);
+    }
+
+    public boolean isReady() {
+        return ready.get();
+    }
+
+    private void handleHealth(HttpExchange exchange) throws IOException {
+        boolean isReady = ready.get();
+        respond(exchange,
+                isReady ? 200 : 503,
+                isReady ? "{\"status\":\"ok\"}" : "{\"status\":\"starting\"}");
+    }
+
+    private void handleLive(HttpExchange exchange) throws IOException {
+        respond(exchange, 200, "{\"status\":\"alive\"}");
+    }
+
+    private void respond(HttpExchange exchange, int status, String body) throws IOException {
+        byte[] bytes = body.getBytes(StandardCharsets.UTF_8);
+        exchange.getResponseHeaders().set("Content-Type", "application/json");
+        exchange.sendResponseHeaders(status, bytes.length);
+        try (OutputStream os = exchange.getResponseBody()) {
+            os.write(bytes);
+        }
+    }
+}
