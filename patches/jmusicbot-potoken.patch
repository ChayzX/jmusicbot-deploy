         {
             applyOAuth(yt, logger);
         }
+
+        // YouTube poToken + visitorData bypass the "Sign in to confirm you're not a bot"
+        // block on the Web client (same mechanism the SeVile/MusicBot fork exposes via
+        // ytpotoken/ytvisitordata config keys). Both must be set together; a stale or
+        // incomplete pair can worsen playback, so only apply when both are present.
+        if (config.getYTPoToken() != null && config.getYTVisitorData() != null)
+        {
+            Web.setPoTokenAndVisitorData(config.getYTPoToken(), config.getYTVisitorData());
+            logger.info("Applied YouTube poToken + visitorData (Web client)");
+        }
         return yt;
     }
     
